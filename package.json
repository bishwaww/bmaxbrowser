{
  "name": "bmax-browser",
  "productName": "BMAX Browser",
  "version": "0.6.1",
  "description": "Privacy-first desktop web browser",
  "private": true,
  "main": "./out/main/index.js",
  "author": "BMAX",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "icons": "electron scripts/make-icons.cjs",
    "verify-binaries": "node scripts/verify-binaries.mjs",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.3",
    "@mozilla/readability": "0.6.0",
    "electron-updater": "6.8.11",
    "tldts": "7.4.19",
    "webtorrent": "3.0.21",
    "zod": "4.6.7"
  },
  "homepage": "https://github.com/bishwaww/bmaxbrowser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bishwaww/bmaxbrowser.git"
  }
}
